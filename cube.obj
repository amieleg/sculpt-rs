# Cube with quads, UVs, and normals

# -------------------------
# Vertex Positions (8 verts)
# -------------------------
v -1 -1 -1
v  1 -1 -1
v  1  1 -1
v -1  1 -1
v -1 -1  1
v  1 -1  1
v  1  1  1
v -1  1  1

# -------------------------
# Texture Coordinates (24 UVs)
# One set of 4 per face
# -------------------------

# Front face
vt 0 0
vt 1 0
vt 1 1
vt 0 1

# Back face
vt 0 0
vt 1 0
vt 1 1
vt 0 1

# Left face
vt 0 0
vt 1 0
vt 1 1
vt 0 1

# Right face
vt 0 0
vt 1 0
vt 1 1
vt 0 1

# Top face
vt 0 0
vt 1 0
vt 1 1
vt 0 1

# Bottom face
vt 0 0
vt 1 0
vt 1 1
vt 0 1

# -------------------------
# Normals (6 face normals)
# -------------------------
vn  0  0 -1   # front
vn  0  0  1   # back
vn -1  0  0   # left
vn  1  0  0   # right
vn  0  1  0   # top
vn  0 -1  0   # bottom

# -------------------------
# Faces (quads: v/vt/vn)
# -------------------------

# Front (-Z)
f 1/1/1 2/2/1 3/3/1 4/4/1

# Back (+Z)
f 5/5/2 8/8/2 7/7/2 6/6/2

# Left (-X)
f 1/9/3 4/12/3 8/11/3 5/10/3

# Right (+X)
f 2/13/4 6/16/4 7/15/4 3/14/4

# Top (+Y)
f 4/17/5 3/18/5 7/19/5 8/20/5

# Bottom (-Y)
f 1/21/6 5/24/6 6/23/6 2/22/6